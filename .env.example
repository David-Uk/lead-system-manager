# Copy this file to .env and fill in your values.
# Every variable is validated by src/config/env.js at startup.
# See README.md for how to obtain each credential (WhatsApp, LLM, MongoDB,
# staff API key) and for how to run simulated vs live mode.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Docker Mongo by default; in docker-compose the api service overrides
# this with mongodb://mongo:27017/<db>. Atlas: mongodb+srv://mongo-atlas-uri.
MONGODB_URI=mongodb://localhost:27017/freshmart

# Staff API key protecting x-api-key endpoints. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STAFF_API_KEY=change-me

# WhatsApp Cloud API.'simulated' (default) logs messages instead of sending;
# 'cloud' performs real sends and needs the phone number id + access token.
WHATSAPP_MODE=simulated
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_FORCE_SEND_FAILURE=false
STAFF_WHATSAPP_NUMBER=

# Hybrid classifier: rules run first; the LLM is consulted when rules are
# unsure. none | gemini | groq | ollama. 'none' = rules-only + escalate.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=5000
CONFIDENCE_THRESHOLD=0.6
RULES_CONFIDENCE_THRESHOLD=0.7

# Ollama Cloud (used when LLM_PROVIDER=ollama). Create a key in your
# ollama.com account settings and paste it below. Base URL only - the
# adapter appends /api/chat; there is no local Ollama setup.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Tickets open longer than this are flagged overdue in metrics.
TICKET_SLA_MINUTES=15
